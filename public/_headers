# ============================================
# Cache Headers: miguelcantu.mba
# ============================================
# IMPORTANTE: este archivo DEBE vivir en public/ (no en out/).
# Cloudflare Pages reconstruye out/ en cada deploy; solo lo que
# está en public/ se copia a out/ y por lo tanto se publica.
# Si se mueve a out/, se borra en el siguiente build y se rompe
# el cacheo (HTML viejo apuntando a chunks que ya no existen → blanco).

# Assets con hash de contenido (JS, CSS) — nombre cambia si cambia
# el contenido, así que se pueden cachear para siempre.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Fuentes — cachear largo
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes — cachear 1 día
/images/*
  Cache-Control: public, max-age=86400

# Todo lo demás (HTML, incluidas las URLs limpias tipo /sobre-mi,
# /consultoria, /blog/...) — SIEMPRE revalidar contra el servidor.
# Esto evita que un navegador sirva un HTML viejo que referencia
# chunks que ya no existen tras un redeploy.
/*
  Cache-Control: public, max-age=0, must-revalidate
